{
  "name": "medidoc",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names BACKEND,FRONTEND --prefix-colors blue,green \"npm:dev:backend\" \"npm:dev:frontend:wait\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:wait": "wait-on tcp:4000 && npm run dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "start": "npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "test": "npm --prefix backend test -- --runInBand",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "wait-on": "^9.0.4"
  }
}
