DATABASE_URL=mysql://root:root@localhost:3306/medico
JWT_SECRET=replace-with-a-long-random-secret
DOCUMENT_SIGNING_SECRET=replace-with-a-separate-document-signing-secret
FRONTEND_URL=http://localhost:3000

# Local Redis. Replace this URL with Redis Cloud/Upstash in production.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL_SECONDS=300

# SMTP email delivery used by Forgot Password OTP.
# Gmail users should use an App Password, never their normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
